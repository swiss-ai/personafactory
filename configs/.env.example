# Copy to .env (or export) and adjust. Every value can also be passed as a CLI argument.

# paths
PF_ROOT=.                          # repository root (Slurm templates; default: submit directory)
PF_DATA_DIR=./data                 # seed datasets, seed shards, persona-bank build, evaluation prompts
PF_OUT_DIR=./outputs               # generated conversations, release build, judge results, reports
PF_LOG_DIR=./logs                  # Slurm and server logs
PF_BANK=./data/persona_bank.jsonl  # the persona bank (built by persona_bank/, or the released `persona_bank` subset)
PF_SEEDS_DIR=./data/seeds/shards   # seed shards written by augmentation.prepare_seeds
PF_LID_MODEL=./data/lid.176.ftz    # fastText language ID (https://fasttext.cc/docs/en/language-identification.html)
PF_LABSE_MODEL=sentence-transformers/LaBSE   # or a local snapshot
PF_MODEL_DIR=                      # optional local model directory (<dir>/<hf-id>); empty = Hugging Face ids
PF_FONT_DIR=                       # optional fonts for figures/

# endpoints (OpenAI-compatible base URLs, .../v1; comma-separated lists for several replicas)
PF_GEMMA_URL=                      # google/gemma-4-31B-it (rewriter, translator, responder)
PF_MINISTRAL_URL=                  # mistralai/Ministral-3-14B-Instruct-2512 (responder)
PF_MINIMAX_URL=                    # MiniMaxAI/MiniMax-M2.5 (judge)
PF_JUDGE_URLS=                     # judge endpoints for evaluation clients
PF_JUDGE_MODEL=MiniMax-M2.5        # served name of the judge
PF_API_KEY=EMPTY                   # any value for self-hosted servers
OPENAI_API_KEY=EMPTY

# serving (scripts/slurm/serve_models.sh)
PF_MAX_MODEL_LEN=65536
PF_SRUN_ARGS=                      # extra srun arguments, e.g. a container image
